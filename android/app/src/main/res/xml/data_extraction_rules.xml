<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the encrypted identity and pairings out of cloud backup and
     device-to-device transfer; the Keystore key cannot move with them. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
